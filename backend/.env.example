# Database
# When running with Docker Compose, use the service name "db" as host:
# DATABASE_URL="postgresql://postgres:password@db:5432/petpals?schema=public"
# When running natively on your machine:
DATABASE_URL="postgresql://postgres:password@localhost:5432/petpals?schema=public"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000"

# Midtrans (Sandbox)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# Biteship (Sandbox)
BITESHIP_API_KEY=""
BITESHIP_IS_PRODUCTION=false
