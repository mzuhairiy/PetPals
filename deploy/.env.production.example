# Database
DB_USER=postgres
DB_PASSWORD=<generate-strong-password>
DATABASE_URL=postgresql://postgres:<password>@db:5432/petpals_production?schema=public

# JWT
JWT_SECRET=<generate-random-64-char-string>
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=production

# CORS
FRONTEND_URL=https://petpals-demo.shop

# Midtrans (Production)
MIDTRANS_SERVER_KEY=<production-server-key>
MIDTRANS_CLIENT_KEY=<production-client-key>
MIDTRANS_IS_PRODUCTION=true

# Biteship (Production)
BITESHIP_API_KEY=<production-api-key>
BITESHIP_IS_PRODUCTION=true
