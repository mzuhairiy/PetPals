# Database
DB_USER=postgres
DB_PASSWORD=<generate-strong-password>
DATABASE_URL=postgresql://postgres:<password>@db:5432/petpals_staging?schema=public

# JWT
JWT_SECRET=<generate-random-64-char-string>
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=staging

# CORS
FRONTEND_URL=https://staging.petpals-demo.shop

# Midtrans (Sandbox)
MIDTRANS_SERVER_KEY=<sandbox-server-key>
MIDTRANS_CLIENT_KEY=<sandbox-client-key>
MIDTRANS_IS_PRODUCTION=false

# Biteship (Test)
BITESHIP_API_KEY=<test-api-key>
BITESHIP_IS_PRODUCTION=false
