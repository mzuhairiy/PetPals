server {
    listen 80;
    server_name staging.petpals-demo.shop;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name staging.petpals-demo.shop;

    ssl_certificate /etc/letsencrypt/live/petpals-demo.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/petpals-demo.shop/privkey.pem;

    # Increase proxy buffer sizes for large headers (JWT tokens)
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location /api/ {
        # Handle CORS preflight at Nginx level as safety net
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' 'https://staging.petpals-demo.shop' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Max-Age' 86400;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        proxy_pass http://127.0.0.1:5100/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Add CORS headers to all API responses (safety net for backend errors/502s)
        add_header 'Access-Control-Allow-Origin' 'https://staging.petpals-demo.shop' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
    }

    location /health {
        proxy_pass http://127.0.0.1:5100/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (for Next.js HMR if needed)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
